# ============================================================
#  Copiez ce fichier en ".env.local" et renseignez les variables
# ============================================================

# URL de votre site WordPress (sans slash final)
#
# ATTENTION — ce fichier ne concerne QUE le développement local.
# Les variables VITE_* sont gravées dans le bundle au moment du build : en production,
# VITE_WP_URL doit être définie dans les variables du dépôt GitHub (Settings > Secrets
# and variables > Actions > Variables), pas sur le serveur de destination, où elle serait
# purement et simplement ignorée. Voir la section "Déploiement" du README.
VITE_WP_URL=https://your-wordpress.com

# Optionnel — afficher la page d'attente tant que cette date n'est pas atteinte
# Format ISO local : YYYY-MM-DDTHH:mm (fuseau local du navigateur)
# VITE_COMING_SOON_UNTIL=2026-06-01T12:00
